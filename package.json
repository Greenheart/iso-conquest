{
    "name": "iso-conquest",
    "version": "2.0.0",
    "description": "A minimalistic turn based strategy game with PvP and experimental AI",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check .",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@iconify-json/lucide": "^1.2.62",
        "@iconify-json/mdi": "^1.2.3",
        "@sveltejs/adapter-static": "^3.0.9",
        "@sveltejs/kit": "^2.30.0",
        "@sveltejs/vite-plugin-svelte": "^6.1.2",
        "@tailwindcss/vite": "^4.1.12",
        "@types/node": "^24.2.1",
        "prettier": "^3.6.2",
        "prettier-plugin-svelte": "^3.4.0",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "svelte": "^5.38.1",
        "svelte-check": "^4.3.1",
        "tailwindcss": "^4.1.12",
        "typescript": "^5.9.2",
        "unplugin-icons": "^22.2.0",
        "vite": "^7.1.2"
    },
    "type": "module",
    "prettier": {
        "semi": false,
        "tabWidth": 4,
        "singleQuote": true,
        "plugins": [
            "prettier-plugin-svelte",
            "prettier-plugin-tailwindcss"
        ],
        "overrides": [
            {
                "files": "*.svelte",
                "options": {
                    "parser": "svelte"
                }
            }
        ]
    }
}
