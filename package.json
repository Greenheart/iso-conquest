{
    "name": "iso-conquest",
    "version": "2.0.0",
    "description": "A minimalistic turn based strategy game with PvP and experimental AI",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check .",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@iconify-json/lucide": "^1.2.72",
        "@iconify-json/mdi": "^1.2.3",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.48.4",
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@tailwindcss/vite": "^4.1.16",
        "@types/node": "^24.10.0",
        "prettier": "^3.6.2",
        "prettier-plugin-svelte": "^3.4.0",
        "prettier-plugin-tailwindcss": "^0.7.1",
        "svelte": "^5.43.4",
        "svelte-check": "^4.3.3",
        "tailwindcss": "^4.1.16",
        "typescript": "^5.9.3",
        "unplugin-icons": "^22.5.0",
        "vite": "^7.2.1"
    },
    "type": "module",
    "prettier": {
        "semi": false,
        "tabWidth": 4,
        "singleQuote": true,
        "plugins": [
            "prettier-plugin-svelte",
            "prettier-plugin-tailwindcss"
        ],
        "overrides": [
            {
                "files": "*.svelte",
                "options": {
                    "parser": "svelte"
                }
            }
        ]
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.3.1"
    }
}
